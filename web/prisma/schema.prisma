generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AGENT
  MODERATOR
  ADMIN
  GER
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

enum TransactionType {
  SALE
  RENT
  RENT_TO_OWN
  INSTALLMENT_SALE
}

enum PropertyType {
  LAND
  HOUSE
  APARTMENT
  OFFICE
}

enum PaperType {
  TF
  BAIL_EMPHYTEOTIQUE
  BAIL_ORDINAIRE
  DELIBERATION
  OTHER
}

enum PaperVerifiedLevel {
  DECLARED
  DOCS_ON_FILE
  DILIGENCE_DONE
}

enum MandateType {
  EXCLUSIVE
  SIMPLE
}

enum MandateStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum PricePeriod {
  MONTH
}

enum GeoPrecision {
  EXACT
  APPROX
  ZONE
}

enum MediaKind {
  PHOTO
  DOCUMENT
}

enum StorageBucket {
  PUBLIC
  VAULT
}

enum LeadSource {
  FORM
  WHATSAPP
  PHONE
  WALK_IN
  ADS_META
  CLASSIFIED
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  VISIT
  OFFER
  WON
  LOST
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(AGENT)
  accounts      Account[]
  sessions      Session[]
  listings      Listing[]
  mandates      Mandate[]
  assignedLeads Lead[]    @relation("LeadAssignee")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Listing {
  id                        String             @id @default(cuid())
  slug                      String?            @unique
  reference                 String?
  status                    ListingStatus      @default(DRAFT)
  transaction               TransactionType
  propertyType              PropertyType
  title                     String
  description               String?            @db.Text
  paperType                 PaperType?
  paperVerifiedLevel        PaperVerifiedLevel @default(DECLARED)
  nicad                     String?
  edrDate                   DateTime?
  dossierNumber             String?
  titleNotes                String?            @db.Text
  deliberationDisclaimerAck Boolean            @default(false)
  priceFcfa                 Int?
  pricePeriod               PricePeriod        @default(MONTH)
  currency                  String             @default("XOF")
  areaM2                    Decimal?           @db.Decimal(12, 2)
  areaHa                    Decimal?           @db.Decimal(12, 4)
  chargesFcfa               Int?
  depositMonths             Decimal?           @db.Decimal(4, 1)
  installmentMonths         Int?
  installmentDownFcfa       Int?
  negotiable                Boolean            @default(false)
  city                      String?
  quartierLabel             String?
  addressPublic             String?
  geoLat                    Float?
  geoLng                    Float?
  geoPrecision              GeoPrecision       @default(APPROX)
  bedrooms                  Int?
  bathrooms                 Int?
  rooms                     Int?
  amenities                 String[]           @default([])
  videoUrl                  String?
  waPhone                   String?
  showPhone                 Boolean            @default(false)
  agentId                   String?
  agent                     User?              @relation(fields: [agentId], references: [id])
  mandate                   Mandate?
  media                     MediaAsset[]
  publishedAt               DateTime?
  archivedAt                DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([agentId, status])
  @@index([status, publishedAt])
}

model Mandate {
  id        String        @id @default(cuid())
  listingId String        @unique
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      MandateType   @default(SIMPLE)
  reference String?
  status    MandateStatus @default(DRAFT)
  agentId   String?
  agent     User?         @relation(fields: [agentId], references: [id])
  media     MediaAsset[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model MediaAsset {
  id        String        @id @default(cuid())
  listingId String?
  listing   Listing?      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  mandateId String?
  mandate   Mandate?      @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  kind      MediaKind
  storage   StorageBucket
  key       String
  url       String?
  mimeType  String
  sizeBytes Int?
  sortOrder Int           @default(0)
  alt       String?
  createdAt DateTime      @default(now())

  @@index([listingId, kind, sortOrder])
  @@unique([key])
}

model Lead {
  id         String     @id @default(cuid())
  name       String?
  email      String?
  phone      String?
  source     LeadSource @default(FORM)
  stage      LeadStage  @default(NEW)
  intent     String?
  message    String?    @db.Text
  listingId  String?
  assigneeId String?
  assignee   User?      @relation("LeadAssignee", fields: [assigneeId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}
