generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AGENT
  MODERATOR
  ADMIN
  GER
  CLIENT
  LANDLORD
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

enum TransactionType {
  SALE
  RENT
  SHORT_TERM_RENT
  RENT_TO_OWN
  INSTALLMENT_SALE
}

enum PropertyType {
  LAND
  HOUSE
  APARTMENT
  OFFICE
}

enum PaperType {
  TF
  BAIL_EMPHYTEOTIQUE
  BAIL_ORDINAIRE
  DELIBERATION
  OTHER
}

enum PaperVerifiedLevel {
  DECLARED
  DOCS_ON_FILE
  DILIGENCE_DONE
}

enum MandateType {
  EXCLUSIVE
  SIMPLE
}

enum MandateStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum PricePeriod {
  MONTH
  NIGHT
  WEEK
}

enum GeoPrecision {
  EXACT
  APPROX
  ZONE
}

enum MediaKind {
  PHOTO
  DOCUMENT
}

enum StorageBucket {
  PUBLIC
  VAULT
}

enum LeadSource {
  FORM
  WHATSAPP
  PHONE
  WALK_IN
  ADS_META
  CLASSIFIED
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  VISIT
  OFFER
  WON
  LOST
  NURTURE
}

enum LeadEventType {
  CREATED
  STAGE_CHANGE
  NOTE
  SYSTEM
}

enum AssignmentRole {
  LANDLORD
  CO_LANDLORD
  CANDIDATE
  TENANT
  BUYER
  GUARANTOR
}

enum AssignmentStatus {
  INVITED
  ACTIVE
  ENDED
  REVOKED
  PROMOTED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

enum DecisionMode {
  AGENCY_DECIDES
  LANDLORD_DECIDES
}

/// Suite donnée par le prospect après visite réalisée (post-mortem).
enum VisitOutcome {
  NOT_INTERESTED
  CONTINUE
  VISIT_OTHER_RENTALS
  NEEDS_TIME
  NO_SHOW
  OTHER
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum VisitSource {
  ONLINE_REQUEST
  OFFLINE
  PHONE
  WALK_IN
  WHATSAPP
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  role          UserRole  @default(AGENT)
  /// Lead converted into this client account (S08).
  convertedFromLeadId String? @unique
  convertedFromLead   Lead?   @relation("LeadConvertedUser", fields: [convertedFromLeadId], references: [id], onDelete: SetNull)
  accounts      Account[]
  sessions      Session[]
  listings      Listing[]
  mandates      Mandate[]
  assignedLeads Lead[]      @relation("LeadAssignee")
  leadEvents    LeadEvent[] @relation("LeadEventActor")
  visitReportsConducted VisitReport[] @relation("VisitConductedBy")
  propertyAssignments PropertyAssignment[]
  rentalApplications  RentalApplication[]
  leasesAsTenant      Lease[] @relation("LeaseTenant")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Listing {
  id                        String             @id @default(cuid())
  slug                      String?            @unique
  reference                 String?
  status                    ListingStatus      @default(DRAFT)
  transaction               TransactionType
  propertyType              PropertyType
  title                     String
  description               String?            @db.Text
  paperType                 PaperType?
  paperVerifiedLevel        PaperVerifiedLevel @default(DECLARED)
  nicad                     String?
  edrDate                   DateTime?
  dossierNumber             String?
  titleNotes                String?            @db.Text
  deliberationDisclaimerAck Boolean            @default(false)
  priceFcfa                 Int?
  pricePeriod               PricePeriod        @default(MONTH)
  currency                  String             @default("XOF")
  areaM2                    Decimal?           @db.Decimal(12, 2)
  areaHa                    Decimal?           @db.Decimal(12, 4)
  chargesFcfa               Int?
  depositMonths             Decimal?           @db.Decimal(4, 1)
  installmentMonths         Int?
  installmentDownFcfa       Int?
  negotiable                Boolean            @default(false)
  /** When transaction=RENT: also offer short-term stay. */
  alsoShortTerm             Boolean            @default(false)
  shortTermPriceFcfa        Int?
  shortTermPricePeriod      PricePeriod?
  minStayDays               Int?
  /** Short-term / furnished stays — null when N/A. */
  furnished                 Boolean?
  city                      String?
  /** Commune / arrondissement (thesaurus middle layer). */
  communeLabel              String?
  quartierLabel             String?
  addressPublic             String?
  geoLat                    Float?
  geoLng                    Float?
  geoPrecision              GeoPrecision       @default(APPROX)
  bedrooms                  Int?
  bathrooms                 Int?
  rooms                     Int?
  amenities                 String[]           @default([])
  videoUrl                  String?
  waPhone                   String?
  showPhone                 Boolean            @default(false)
  agentId                   String?
  agent                     User?              @relation(fields: [agentId], references: [id])
  mandate                   Mandate?
  media                     MediaAsset[]
  leads                     Lead[]
  visitReports              VisitReport[]
  propertyAssignments       PropertyAssignment[]
  requirementSets           ApplicationRequirementSet[]
  rentalApplications        RentalApplication[]
  leases                    Lease[]
  decisionMode              DecisionMode       @default(AGENCY_DECIDES)
  publishedAt               DateTime?
  archivedAt                DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([agentId, status])
  @@index([status, publishedAt])
}

model Mandate {
  id        String        @id @default(cuid())
  listingId String        @unique
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      MandateType   @default(SIMPLE)
  reference String?
  status    MandateStatus @default(DRAFT)
  agentId   String?
  agent     User?         @relation(fields: [agentId], references: [id])
  media     MediaAsset[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model MediaAsset {
  id        String        @id @default(cuid())
  listingId String?
  listing   Listing?      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  mandateId String?
  mandate   Mandate?      @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  kind      MediaKind
  storage   StorageBucket
  key       String
  url       String?
  mimeType  String
  sizeBytes Int?
  sortOrder Int           @default(0)
  alt       String?
  createdAt DateTime      @default(now())

  @@index([listingId, kind, sortOrder])
  @@unique([key])
}

model Lead {
  id             String     @id @default(cuid())
  name           String?
  email          String?
  phone          String?
  source         LeadSource @default(FORM)
  /// Surface tag e.g. form_fiche · form_contact · wa_fiche · form_visite
  sourceDetail   String?
  /// prospect | client soft — visit flow marks prospect
  leadType       String?
  stage          LeadStage  @default(NEW)
  intent         String?
  /// Preferred visit slot (free text / ISO soft)
  preferredSlot  String?
  message        String?    @db.Text
  consentContact Boolean    @default(false)
  listingId      String?
  listing        Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       User?      @relation("LeadAssignee", fields: [assigneeId], references: [id])
  convertedUser  User?      @relation("LeadConvertedUser")
  visitReports   VisitReport[]
  /// Clock start = createdAt; set when agent first moves off NEW / adds note.
  firstTouchAt   DateTime?
  /// Soft SLA deadline (default createdAt + 24h).
  slaDueAt       DateTime?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  events         LeadEvent[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([assigneeId, stage, createdAt])
  @@index([stage, slaDueAt])
  @@index([listingId])
  @@index([phone])
  @@index([email])
  @@index([leadType, stage])
}

model LeadEvent {
  id         String        @id @default(cuid())
  leadId     String
  lead       Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       LeadEventType
  fromStage  LeadStage?
  toStage    LeadStage?
  body       String?       @db.Text
  actorId    String?
  actor      User?         @relation("LeadEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())

  @@index([leadId, createdAt])
}

/// Visite planifiée ou réalisée (online / offline) + post-mortem à la clôture.
model VisitReport {
  id              String       @id @default(cuid())
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  listingId       String?
  listing         Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  status          VisitStatus  @default(SCHEDULED)
  source          VisitSource  @default(ONLINE_REQUEST)
  /// Agent responsable (prévu ou qui a fait la visite)
  conductedById   String
  conductedBy     User         @relation("VisitConductedBy", fields: [conductedById], references: [id])
  /// Créneau prévu (offline / planifié)
  scheduledAt     DateTime?
  /// Quand la visite a effectivement eu lieu (à la clôture)
  conductedAt     DateTime?
  outcome         VisitOutcome?
  /// Motifs si NOT_INTERESTED / OTHER / etc.
  outcomeMotif    String?      @db.Text
  /// Notes agent (ambiance, objections…)
  agentNotes      String?      @db.Text
  /// Soft: prospect veut voir d’autres biens (si VISIT_OTHER_RENTALS)
  wantsOtherListings Boolean   @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([leadId, scheduledAt])
  @@index([conductedById, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([listingId])
  @@index([outcome])
}

/// Thesaurus villes — rattachées à une région (région → ville → commune → quartier).
model City {
  id        String    @id @default(cuid())
  name      String    @unique
  /// Région administrative SN (obligatoire).
  region    String
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  communes  Commune[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, sortOrder])
  @@index([region, name])
}

/// Thesaurus communes / arrondissements rattachés à une ville.
model Commune {
  id        String     @id @default(cuid())
  name      String
  cityId    String
  city      City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  quartiers Quartier[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([cityId, name])
  @@index([active, name])
}

/// Thesaurus quartiers / localités rattachés à une commune.
model Quartier {
  id        String   @id @default(cuid())
  name      String
  communeId String
  commune   Commune  @relation(fields: [communeId], references: [id], onDelete: Cascade)
  aliases   String[] @default([])
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  /// Approximate public pin = quartier center (listings inherit this).
  centerLat      Float?
  centerLng      Float?
  /// OSM | GEONAMES | ADMIN | MANUAL
  geoSource      String?
  /// OK | LOW | MISSING
  geoStatus      String?
  geoExternalId  String?
  geoFetchedAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([communeId, name])
  @@index([active, name])
  @@index([geoStatus])
}

/// Lien user ↔ listing (landlord / candidate / tenant / …) — S08.
model PropertyAssignment {
  id        String           @id @default(cuid())
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AssignmentRole
  status    AssignmentStatus @default(INVITED)
  note      String?          @db.Text
  createdById String?
  applications RentalApplication[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([listingId, role, status])
  @@index([userId, role, status])
  @@unique([listingId, userId, role])
}

/// Template / set d'exigences dossier pour un listing.
model ApplicationRequirementSet {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name      String   @default("Standard SN")
  /// JSON array: { code, label, required, kind: file|condition }[]
  itemsJson String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, active])
}

model RentalApplication {
  id                   String            @id @default(cuid())
  listingId            String
  listing              Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId         String
  assignment           PropertyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  status               ApplicationStatus @default(DRAFT)
  /// 0–100 vs exigences required
  completenessPct      Int               @default(0)
  /// Agent-facing summary for landlord (no file refs)
  agentSummary         String?           @db.Text
  privacyNoticeVersion String?
  privacyAcceptedAt    DateTime?
  dueAt                DateTime?
  reviewedAt           DateTime?
  decidedAt            DateTime?
  rejectReason         String?
  documents            ApplicationDocument[]
  lease                Lease?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([listingId, status])
  @@index([userId, status])
  @@index([assignmentId])
}

model ApplicationDocument {
  id            String            @id @default(cuid())
  applicationId String
  application   RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// Requirement code e.g. cni · pay_stubs_3
  requirementCode String
  storageKey    String            @unique
  mimeType      String
  sizeBytes     Int?
  originalName  String?
  uploadedById  String?
  createdAt     DateTime          @default(now())

  @@index([applicationId, requirementCode])
}

model Lease {
  id            String      @id @default(cuid())
  listingId     String
  listing       Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenantUserId  String
  tenant        User        @relation("LeaseTenant", fields: [tenantUserId], references: [id])
  applicationId String?     @unique
  application   RentalApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  status        LeaseStatus @default(DRAFT)
  startDate     DateTime?
  endDate       DateTime?
  rentFcfa      Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([listingId, status])
  @@index([tenantUserId, status])
}
