generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AGENT
  MODERATOR
  ADMIN
  GER
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

enum TransactionType {
  SALE
  RENT
  RENT_TO_OWN
  INSTALLMENT_SALE
}

enum PropertyType {
  LAND
  HOUSE
  APARTMENT
  OFFICE
}

enum PaperType {
  TF
  BAIL_EMPHYTEOTIQUE
  BAIL_ORDINAIRE
  DELIBERATION
  OTHER
}

enum PaperVerifiedLevel {
  DECLARED
  DOCS_ON_FILE
  DILIGENCE_DONE
}

enum LeadSource {
  FORM
  WHATSAPP
  PHONE
  WALK_IN
  ADS_META
  CLASSIFIED
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  VISIT
  OFFER
  WON
  LOST
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(AGENT)
  accounts      Account[]
  sessions      Session[]
  listings      Listing[]
  assignedLeads Lead[]    @relation("LeadAssignee")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Draft-ready listing — full catalogue fields land in S01.
model Listing {
  id                 String              @id @default(cuid())
  slug               String?             @unique
  reference          String?
  status             ListingStatus       @default(DRAFT)
  transaction        TransactionType
  propertyType       PropertyType
  title              String
  description        String?             @db.Text
  paperType          PaperType?
  paperVerifiedLevel PaperVerifiedLevel  @default(DECLARED)
  priceFcfa          Int?
  city               String?
  quartierLabel      String?
  agentId            String?
  agent              User?               @relation(fields: [agentId], references: [id])
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

/// Minimal lead — CRM pipeline expands in S03.
model Lead {
  id         String     @id @default(cuid())
  name       String?
  email      String?
  phone      String?
  source     LeadSource @default(FORM)
  stage      LeadStage  @default(NEW)
  intent     String?
  message    String?    @db.Text
  listingId  String?
  assigneeId String?
  assignee   User?      @relation("LeadAssignee", fields: [assigneeId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}
