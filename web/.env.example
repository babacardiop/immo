# Neon Postgres (use pooled URL for app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
# Staging / prod public URL (no trailing slash)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp Business number E.164 (no +)
NEXT_PUBLIC_WA_E164="221770000000"

# Seed agent (prisma db seed)
SEED_AGENT_EMAIL="agent@evergreen.sn"
SEED_AGENT_PASSWORD="ChangeMeStaging1!"

# Cloudflare R2 (S3-compatible)
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY="replace-me"
S3_SECRET="replace-me"
S3_BUCKET_PUBLIC="evergreen-photos"
S3_BUCKET_VAULT="evergreen-vault"
S3_PUBLIC_BASE_URL="https://pub-xxxxx.r2.dev"
