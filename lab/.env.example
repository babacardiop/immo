# --- Lab data (evergreen_lab on Neon) ---
# Pooled for the app, direct for prisma migrate.
LAB_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/evergreen_lab?sslmode=require"
LAB_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/evergreen_lab?sslmode=require"

# --- Hub identity (read-only) ---
# Role lab_hub_reader: SELECT on a few "User" columns only. Create with `npm run hub:create-reader`.
HUB_AUTH_DATABASE_URL="postgresql://lab_hub_reader:PASSWORD@HOST-pooler/neondb?sslmode=require"

# Auth.js for the lab app (can differ from the hub's AUTH_SECRET in MVP option B).
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST="true"

# Crawler identity — keep a real contact page behind this URL before scaling.
LAB_BOT_USER_AGENT="EverGreenResearchBot/0.1 (+https://evergreen.sn/bot)"
