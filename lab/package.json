{
  "name": "lab",
  "version": "0.1.0",
  "private": true,
  "description": "EverGreen Research Lab — internal market intelligence app (separate DB from the hub).",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "sources:seed": "tsx --env-file=.env scripts/seed-sources.ts",
    "sources:probe": "tsx --env-file=.env scripts/probe-sources.ts",
    "hub:create-reader": "node scripts/create-hub-reader.mjs",
    "postinstall": "prisma generate",
    "crawl": "tsx --env-file=.env scripts/crawl.ts",
    "crawl:all": "tsx --env-file=.env scripts/crawl-all.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
